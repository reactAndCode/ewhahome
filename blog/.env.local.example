# ==============================================================================
# 이화미술공작소 Supabase 환경 변수 설정
# ==============================================================================
# Supabase 대시보드 (https://supabase.com/dashboard) 에서 프로젝트 생성 후
# Project Settings -> API 에서 아래 값들을 복사하여 붙여넣으세요.
# 키를 입력하지 않아도 스마트 로컬 스토리지 Fallback 모드로 100% 정상 작동합니다.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
